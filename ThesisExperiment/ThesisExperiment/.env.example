# ThesisExperiment Environment Variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# The .env file is gitignored and will NOT be committed.

# Required for Steps 5+6 (run-single-shot, run-repair-loop)
OPENAI_API_KEY=sk-your-key-here

# Optional for Step 1 (select-projects). Without it, GitHub limits to 60 req/hr.
GITHUB_TOKEN=ghp_your-token-here
